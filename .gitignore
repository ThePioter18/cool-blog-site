# Ignore everything by default
*

# Keep this file
!.gitignore

# Allow custom theme
!/themes/
/themes/*
!/themes/cool-blog-theme/
!/themes/cool-blog-theme/**

# Allow custom plugins
!/plugins/
!/plugins/first-unique-plugin/
!/plugins/first-unique-plugin/**
!/plugins/word-filter-plugin/
!/plugins/word-filter-plugin/**

# Allow custom mu-plugins
!/mu-plugins/
!/mu-plugins/**

# Ignore backup files
**/*~